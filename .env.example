# Dev-only overrides.
#
# The PACKAGED Mac app does NOT read this file — a double-clicked .app gets no
# shell environment. On the event machine everything below is configured in the
# app's Settings panel and stored in ~/Library/Application Support/Event Uploader/
# (the AWS secret is encrypted with Electron safeStorage / macOS Keychain).
#
# These vars only seed defaults when running `npm run dev` from a terminal.

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=

# Where guests land. Must point at the gallery web app, not the bucket.
PUBLIC_BASE_URL=http://localhost:8080

# Optional CDN / custom domain that fronts the bucket for image files.
# Leave blank to use the default S3 URL.
PUBLIC_ASSET_BASE_URL=

# Gallery web app (apps/gallery)
PORT=8080
