  },
  "dependencies": {
    "@eps/core": "*",
    "archiver": "^8.0.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
